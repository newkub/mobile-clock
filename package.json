{
  "name": "mobile-clock",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Wrikka Clock — local-first Alarm, Stopwatch, Timer, Pomodoro & Reminder for Android (Capacitor 8) and PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:spa": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "cap:sync": "bun run build:spa && cap sync android",
    "cap:copy": "bun run build:spa && cap copy android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "cap:add:android": "cap add android",
    "test": "mise x -- node node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "deploy": "bun run build:spa && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "solid-js": "^1.9.15",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@iconify-json/mdi": "^1.2.3",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.12.0",
    "typescript": "^7.0.2",
    "unocss": "^66.10.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}